# Copy this file to .env.local and fill in your key.
# The key is only ever read on the server (app/api/generate/route.ts).
ANTHROPIC_API_KEY=sk-ant-...

# Only needed if your key is not scoped to a workspace (the API then asks for
# an anthropic-workspace-id header). Find the ID in Console -> Settings -> Workspaces.
# ANTHROPIC_WORKSPACE_ID=wrkspc_...

# Optional compile-check loop (see compile-service/). If either is missing the
# app still works and shows "Compile check not configured".
# COMPILE_SERVICE_URL=http://localhost:8080
# COMPILE_SERVICE_TOKEN=change-me
