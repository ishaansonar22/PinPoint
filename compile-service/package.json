{
  "name": "pinpoint-compile-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "arduino-cli compile service for PinPoint",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vitest": "^5.0.1"
  }
}
